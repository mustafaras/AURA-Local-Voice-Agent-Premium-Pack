# macOS Finder metadata is local OS state, never authored repository content.
.DS_Store

# Python bytecode is reproducible from tracked source and must not be tracked.
__pycache__/
*.py[cod]

# Local Swift/Xcode build output and the root development Python environment.
/.build
/.venv/
/Packages

# IDE and platform-generated state.
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc

# iCloud Drive conflict copies. This repository lives under a synced Desktop,
# and iCloud resolves a conflict by writing "Name 2.swift" beside "Name.swift".
# SwiftPM globs Sources/**/*.swift, so a stray copy is not merely untidy — it
# redeclares every type in the file and breaks the build.
* 2.*
* [0-9].swift

# SP-011 acceptance private values (approved test account, OAuth client)
scripts/sp011-acceptance/acceptance.env

# SP-011 fixture TLS material — regenerated on demand, never tracked
scripts/sp011-acceptance/fixtures/*.pem
