{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["$schema","schema_version","program_id","program_document","state_file","prompt_directory","validator","prompts"],
  "properties":{
    "$schema":{"type":"string"},
    "schema_version":{"const":"1.0.0"},
    "program_id":{"const":"AURA-REPO-HYGIENE"},
    "program_document":{"const":"docs/operations/REPO_HYGIENE_PROGRAM.md"},
    "state_file":{"const":"AURA_RUNTIME_COMPLETION/repo-hygiene/REPO_HYGIENE_STATE.json"},
    "prompt_directory":{"const":"AURA_RUNTIME_COMPLETION/prompts/repo_hygiene"},
    "validator":{"const":"scripts/validate_repo_hygiene_program.py"},
    "prompts":{
      "type":"array","minItems":11,"maxItems":11,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","sequence","gap_id","title","file","depends_on","next_prompt"],
        "properties":{
          "id":{"type":"string","pattern":"^H-[0-9]{3}$"},
          "sequence":{"type":"integer","minimum":0,"maximum":10},
          "gap_id":{"type":"string","pattern":"^HYGIENE-[0-9]{2}$"},
          "title":{"type":"string","minLength":3},
          "file":{"type":"string","pattern":"^AURA_RUNTIME_COMPLETION/prompts/repo_hygiene/H-[0-9]{3}_.+\\.prompt\\.md$"},
          "depends_on":{"type":["string","null"],"pattern":"^H-[0-9]{3}$"},
          "next_prompt":{"type":["string","null"],"pattern":"^H-[0-9]{3}$"}
        }
      }
    }
  }
}
