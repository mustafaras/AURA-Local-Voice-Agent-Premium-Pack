{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/runtime-completion/prompt-manifest.schema.json",
  "title": "AURA Runtime Completion Prompt Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_version", "program_name", "shared_contract", "state_file", "handoff_file", "prompts"],
  "properties": {
    "$schema": { "type": "string", "const": "../schemas/prompt-manifest.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "program_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "program_name": { "const": "AURA Runtime Completion Program" },
    "shared_contract": { "const": "AURA_RUNTIME_COMPLETION/prompts/SHARED_EXECUTION_CONTRACT.md" },
    "state_file": { "const": "AURA_RUNTIME_COMPLETION/state/current-state.json" },
    "handoff_file": { "const": "AURA_RUNTIME_COMPLETION/context/session-handoff.json" },
    "prompts": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "name", "file", "dependencies", "completion_gate", "state_outputs"],
        "properties": {
          "order": { "type": "integer", "minimum": 0, "maximum": 99 },
          "id": { "type": "string", "pattern": "^(BOOTSTRAP|R[0-9]+|FINAL)$" },
          "name": { "type": "string", "minLength": 3, "maxLength": 200 },
          "file": { "type": "string", "pattern": "^AURA_RUNTIME_COMPLETION/prompts/.+\\.prompt\\.md$" },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^(BOOTSTRAP|R[0-9]+|FINAL)$" }
          },
          "completion_gate": { "type": "string", "minLength": 10, "maxLength": 2000 },
          "state_outputs": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "optional_context": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    }
  }
}
