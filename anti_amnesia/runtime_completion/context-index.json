  "tiers": [
    {
      "id": "T0",
      "name": "Mandatory startup context",
      "load_rule": "Always load in a fresh session before any edit. Keep this set stable and small.",
      "files": [
        "AGENTS.md",
        "prompts/runtime_completion/SHARED_EXECUTION_CONTRACT.md",
        "ledger/runtime_completion/current-state.json",
        "anti_amnesia/runtime_completion/session-handoff.json",
        "anti_amnesia/runtime_completion/READ_FIRST.md"
      ]
    },
    {
      "id": "T1",
      "name": "Active prompt context",
      "load_rule": "Load the active prompt, relevant capability entries, direct production files, direct tests, and accepted ADRs named by the prompt.",
      "files": [
        "prompts/runtime_completion/prompt-manifest.json",
        "ledger/runtime_completion/capability-matrix.json",
        "ledger/runtime_completion/EVIDENCE_INDEX.md",
        "ledger/runtime_completion/RISK_REGISTER.md",
        "ledger/runtime_completion/DECISION_REGISTER.md"
      ]
    },
    {
      "id": "T2",
      "name": "Conditional architecture and history",
      "load_rule": "Load only to resolve a material architecture question, verify a historical claim, or investigate a regression.",
      "files": [
        "docs/roadmap/AURA_FULLY_OPERATIONAL_ASSISTANT_MASTER_PLAN.md",
        "anti_amnesia/runtime_completion/KNOWN_FACTS.md",
        "anti_amnesia/runtime_completion/ACTIVE_CONTEXT.md",
        "ledger/runtime_completion/PROGRAM_LEDGER.md",
        "ledger/PROJECT_LEDGER.md",
        "ledger/CURRENT_STATE.md",
        "SESSION_STARTER.md",
        "docs/decisions"
      ]
    },
    {
      "id": "T3",
      "name": "External and bulky evidence",
      "load_rule": "Load only the exact official documentation, command output, logs, recordings, screenshots, or artifacts needed for the current gate. Summarize and index; do not retain bulky content in context.",
      "files": [
        "official platform documentation",
        "installed tool help and version output",
        "build/test logs",
        "release artifacts",
        "live hardware evaluation artifacts"
      ]
    }
  ],
