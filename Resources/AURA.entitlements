<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime: permits the local voice pipeline to access audio input. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!--
      The main app is intentionally not App Sandbox enabled because its typed,
      policy-gated CLI and Accessibility adapters require capabilities that
      must first migrate to dedicated helpers. Network access is constrained
      by AURA policy/allowlists, not falsely represented as kernel sandbox
      enforcement. AuraPluginHost remains separately App Sandbox confined.

      Accessibility and Screen Recording are protected by macOS TCC user
      consent. There are no com.apple.security.accessibility or
      com.apple.security.screen-recording entitlements.

      The com.apple.security.device.microphone and user-selected file
      entitlements are App Sandbox keys and therefore do not belong on this
      non-sandboxed executable. Hardened Runtime uses the audio-input
      entitlement above. Microphone and Speech Recognition remain protected
      by their Info.plist usage strings and macOS TCC consent.

      Hardened-runtime behavior is enabled by codesign options, not
      false-valued entitlement entries.
    -->
</dict>
</plist>
